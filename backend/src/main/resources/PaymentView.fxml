<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="features.payment.PaymentController"
      spacing="0"
      style="-fx-background-color: #f5f4f0;">

<!--    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"-->
<!--                style="-fx-background: transparent; -fx-background-color: transparent;">-->
        <VBox spacing="24">
            <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

            <!-- Header -->
            <VBox spacing="4">
                <Label text="Payments"
                       style="-fx-font-size: 22px; -fx-font-weight: 500; -fx-text-fill: #2c2c2a;"/>
                <Label fx:id="periodLabel"
                       text=""
                       style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
            </VBox>

            <!-- Payment Statement -->
            <VBox fx:id="statementCard" spacing="12"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                    -fx-border-color: #dddcda; -fx-border-radius: 10; -fx-border-width: 1;">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <Label text="Payment Statement"
                       style="-fx-font-size: 15px; -fx-font-weight: 500; -fx-text-fill: #2c2c2a;"/>

                <!-- Summary row -->
                <HBox spacing="12">
                    <!-- Total Cost -->
                    <VBox spacing="4" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #f5f4f0; -fx-background-radius: 8;">
                        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                        <Label text="Total Cost"
                               style="-fx-font-size: 11px; -fx-text-fill: #888780;"/>
                        <Label fx:id="totalCostLabel"
                               text="—"
                               style="-fx-font-size: 15px; -fx-font-weight: 500; -fx-text-fill: #2c2c2a;"/>
                    </VBox>
                    <!-- Remaining Balance -->
                    <VBox spacing="4" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #f5f4f0; -fx-background-radius: 8;">
                        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                        <Label text="Remaining Balance"
                               style="-fx-font-size: 11px; -fx-text-fill: #888780;"/>
                        <Label fx:id="remainingBalanceLabel"
                               text="—"
                               style="-fx-font-size: 15px; -fx-font-weight: 500; -fx-text-fill: #c0392b;"/>
                    </VBox>
                    <!-- Payment Plan -->
                    <VBox spacing="4" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #f5f4f0; -fx-background-radius: 8;">
                        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                        <Label text="Payment Plan"
                               style="-fx-font-size: 11px; -fx-text-fill: #888780;"/>
                        <Label fx:id="paymentPlanLabel"
                               text="—"
                               style="-fx-font-size: 15px; -fx-font-weight: 500; -fx-text-fill: #2c2c2a;"/>
                    </VBox>
                    <!-- Downpayment -->
                    <VBox spacing="4" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #f5f4f0; -fx-background-radius: 8;">
                        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                        <Label text="Downpayment"
                               style="-fx-font-size: 11px; -fx-text-fill: #888780;"/>
                        <Label fx:id="downpaymentStatusLabel"
                               text="—"
                               style="-fx-font-size: 15px; -fx-font-weight: 500; -fx-text-fill: #2c2c2a;"/>
                    </VBox>
                </HBox>

                <!-- Quarterly breakdown table (only shown if quarterly plan) -->
                <VBox fx:id="quarterlySection" spacing="0" managed="false" visible="false">
                    <padding><Insets top="8"/></padding>

                    <!-- Table header -->
                    <HBox style="-fx-background-color: #f5f4f0; -fx-background-radius: 6 6 0 0;">
                        <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
                        <Label text="Quarter" style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-pref-width: 120;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Scheduled"
                               style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-pref-width: 120;"/>
                        <Label text="Paid"
                               style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-pref-width: 120;"/>
                        <Label text="Balance"
                               style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-pref-width: 120;"/>
                        <Label text=""
                               style="-fx-pref-width: 60;"/>
                    </HBox>

                    <!-- Quarter rows injected here -->
                    <VBox fx:id="quarterRowsContainer" spacing="0"/>
                </VBox>
            </VBox>

            <!-- Payment Form -->
            <VBox spacing="16"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-border-color: #dddcda; -fx-border-radius: 10; -fx-border-width: 1;">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <Label text="Make a Payment"
                       style="-fx-font-size: 15px; -fx-font-weight: 500; -fx-text-fill: #2c2c2a;"/>

                <!-- Row 1: Student ID + Name -->
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Student ID"
                               style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
                        <TextField fx:id="studentIdField"
                                   editable="false"
                                   style="-fx-background-color: #f5f4f0; -fx-background-radius: 6;
                                          -fx-border-color: #dddcda; -fx-border-radius: 6;
                                          -fx-padding: 8 12; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Name"
                               style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
                        <TextField fx:id="studentNameField"
                                   editable="false"
                                   style="-fx-background-color: #f5f4f0; -fx-background-radius: 6;
                                          -fx-border-color: #dddcda; -fx-border-radius: 6;
                                          -fx-padding: 8 12; -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>

                <!-- Row 2: Email + Course -->
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Email Address"
                               style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
                        <TextField fx:id="emailField"
                                   editable="false"
                                   style="-fx-background-color: #f5f4f0; -fx-background-radius: 6;
                                          -fx-border-color: #dddcda; -fx-border-radius: 6;
                                          -fx-padding: 8 12; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Course"
                               style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
                        <TextField fx:id="courseField"
                                   editable="false"
                                   style="-fx-background-color: #f5f4f0; -fx-background-radius: 6;
                                          -fx-border-color: #dddcda; -fx-border-radius: 6;
                                          -fx-padding: 8 12; -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>

                <!-- Row 3: Term + School Year -->
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Term"
                               style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
                        <TextField fx:id="termField"
                                   editable="false"
                                   style="-fx-background-color: #f5f4f0; -fx-background-radius: 6;
                                          -fx-border-color: #dddcda; -fx-border-radius: 6;
                                          -fx-padding: 8 12; -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="School Year"
                               style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
                        <TextField fx:id="schoolYearField"
                                   editable="false"
                                   style="-fx-background-color: #f5f4f0; -fx-background-radius: 6;
                                          -fx-border-color: #dddcda; -fx-border-radius: 6;
                                          -fx-padding: 8 12; -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>

                <!-- Row 4: Payment For + Payment Method -->
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Payment For"
                               style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
                        <ComboBox fx:id="paymentForCombo"
                                  prefWidth="9999"
                                  maxWidth="Infinity"
                                  style="-fx-background-color: white;
                                  -fx-border-color: #dddcda;
                                  -fx-border-radius: 6;
                                  -fx-font-size: 13px;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Payment Method"
                               style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
                        <ComboBox fx:id="paymentMethodCombo"
                                  prefWidth="9999"
                                  maxWidth="Infinity"
                                  style="-fx-background-color: white;
                                  -fx-border-color: #dddcda;
                                  -fx-border-radius: 6;
                                  -fx-font-size: 13px;"/>
                    </VBox>
                </HBox>

                <!-- Row 5: Amount -->
                <VBox spacing="6">
                    <Label text="Amount"
                           style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
                    <TextField fx:id="amountField"
                               promptText="0.00"
                               style="-fx-background-color: white; -fx-background-radius: 6;
                                      -fx-border-color: #dddcda; -fx-border-radius: 6;
                                      -fx-padding: 8 12; -fx-font-size: 13px;"/>
                </VBox>

                <!-- Error label -->
                <Label fx:id="errorLabel"
                       text=""
                       visible="false"
                       managed="false"
                       wrapText="true"
                       style="-fx-font-size: 12px; -fx-text-fill: #c0392b;"/>

                <!-- Pay Now button -->
                <HBox alignment="CENTER_RIGHT">
                    <Button text="Pay Now"
                            onAction="#handlePayNow"
                            style="-fx-background-color: #2c2c2a; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-background-radius: 6;
                                   -fx-padding: 10 24; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- Payment History -->
            <VBox spacing="12"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-border-color: #dddcda; -fx-border-radius: 10; -fx-border-width: 1;">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <Label text="Payment History"
                       style="-fx-font-size: 15px; -fx-font-weight: 500; -fx-text-fill: #2c2c2a;"/>

                <!-- History table header -->
                <HBox style="-fx-background-color: #f5f4f0; -fx-background-radius: 6;">
                    <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
                    <Label text="Date" style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-pref-width: 160;"/>
                    <Label text="Type" style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-pref-width: 120;"/>
                    <Label text="Quarter" style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-pref-width: 100;"/>
                    <Label text="Method" style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-pref-width: 120;"/>
                    <Label text="Amount" style="-fx-font-size: 11px; -fx-text-fill: #888780;" HBox.hgrow="ALWAYS"/>
                </HBox>

                <VBox fx:id="historyContainer" spacing="0"/>
            </VBox>

        </VBox>
<!--    </ScrollPane>-->
</VBox>