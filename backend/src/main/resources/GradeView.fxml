<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="features.grades.GradeController"
      spacing="24"
      style="-fx-background-color: transparent;">

    <padding><Insets top="8" right="0" bottom="32" left="0"/></padding>

    <!-- Student info header -->
    <VBox fx:id="studentHeader" spacing="8"
          style="-fx-background-color: white; -fx-background-radius: 10;
                 -fx-border-color: #dddcda; -fx-border-radius: 10; -fx-border-width: 1;">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    </VBox>

    <!-- Semester groups injected here -->
    <VBox fx:id="semesterGroupsContainer" spacing="24"/>

    <!-- Loading / empty state -->
    <Label fx:id="statusLabel"
           text="Loading grades..."
           style="-fx-font-size: 13px; -fx-text-fill: #888780;"/>

</VBox>