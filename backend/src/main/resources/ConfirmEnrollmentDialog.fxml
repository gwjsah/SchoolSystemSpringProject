<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="features.enrollment.ConfirmEnrollmentController"
      spacing="0"
      prefWidth="420"
      style="-fx-background-color: #f5f4f0; -fx-background-radius: 10;">

    <!-- Header -->
    <VBox spacing="4" style="-fx-background-color: #2c2c2a; -fx-background-radius: 10 10 0 0;">
        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
        <Label text="Confirm Enrollment"
               style="-fx-font-size: 15px; -fx-font-weight: 500; -fx-text-fill: white;"/>
        <Label text="Choose your payment plan to proceed"
               style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
    </VBox>

    <VBox spacing="16">
        <padding><Insets top="24" right="24" bottom="8" left="24"/></padding>

        <!-- Cost summary -->
        <VBox spacing="6"
              style="-fx-background-color: #eeecea; -fx-background-radius: 8;">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <HBox>
                <Label text="Tuition total: " style="-fx-font-size: 13px; -fx-text-fill: #555452;" HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalCostLabel" text="PHP 0.00"
                       style="-fx-font-size: 13px; -fx-text-fill: #2c2c2a; -fx-font-weight: 500;"/>
            </HBox>
            <HBox>
                <Label text="Downpayment: " style="-fx-font-size: 13px; -fx-text-fill: #555452;" HBox.hgrow="ALWAYS"/>
                <Label text="PHP 1,000.00"
                       style="-fx-font-size: 13px; -fx-text-fill: #2c2c2a; -fx-font-weight: 500;"/>
            </HBox>
<!--            <HBox>-->
<!--                <Label text="Remaining balance: " style="-fx-font-size: 13px; -fx-text-fill: #555452;" HBox.hgrow="ALWAYS"/>-->
<!--                <Label fx:id="remainingLabel" text="PHP 0.00"-->
<!--                       style="-fx-font-size: 13px; -fx-text-fill: #2c2c2a; -fx-font-weight: 500;"/>-->
<!--            </HBox>-->
        </VBox>

        <!-- Payment plan -->
        <VBox spacing="8">
            <Label text="Payment plan"
                   style="-fx-font-size: 12px; -fx-text-fill: #888780; -fx-font-weight: 500;"/>

            <fx:define>
                <ToggleGroup fx:id="paymentPlanGroup"/>
            </fx:define>

            <VBox fx:id="quarterlyOption" spacing="2"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #2c2c2a; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-cursor: hand;">
                <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <RadioButton fx:id="quarterlyRadio" text="Quarterly"
                                 toggleGroup="$paymentPlanGroup"
                                 selected="true"
                                 style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #2c2c2a;" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label text="Pay in 4 equal installments across the semester"
                       style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
            </VBox>

            <VBox fx:id="fullOption" spacing="2"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #dddcda; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-cursor: hand;">
                <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <RadioButton fx:id="fullRadio" text="Full Payment"
                                 toggleGroup="$paymentPlanGroup"
                                 style="-fx-font-size: 13px; -fx-font-weight: 500; -fx-text-fill: #2c2c2a;" HBox.hgrow="ALWAYS"/>
                    <Label text="5% off"
                           style="-fx-background-color: #d4edda; -fx-text-fill: #2d6a4f; -fx-font-size: 11px; -fx-background-radius: 10; -fx-padding: 2 8;"/>
                </HBox>
                <Label text="Pay the full balance upfront and save 5%"
                       style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
            </VBox>
        </VBox>
    </VBox>

    <!-- Footer -->
    <HBox alignment="CENTER_RIGHT" spacing="10"
          style="-fx-border-color: #dddcda transparent transparent transparent; -fx-border-width: 1 0 0 0;">
        <padding><Insets top="16" right="24" bottom="20" left="24"/></padding>
        <Button text="Cancel"
                onAction="#handleCancel"
                style="-fx-background-color: transparent; -fx-text-fill: #888780; -fx-font-size: 13px; -fx-background-radius: 6; -fx-padding: 8 16; -fx-border-color: #dddcda; -fx-border-radius: 6; -fx-border-width: 1; -fx-cursor: hand;"/>
        <Button text="Confirm"
                onAction="#handleConfirm"
                style="-fx-background-color: #2c2c2a; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;"/>
    </HBox>
</VBox>
