<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="features.auth.AuthController"
      alignment="CENTER"
      spacing="0"
      style="-fx-background-color: #f5f4f0;"
      prefWidth="420" prefHeight="520">

    <VBox alignment="CENTER" spacing="24"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e0ded8; -fx-border-radius: 12; -fx-border-width: 0.5;"
          maxWidth="340">
        <padding><Insets top="40" right="36" bottom="40" left="36"/></padding>

        <!-- Header -->
        <VBox alignment="CENTER" spacing="6">
            <Label text="School Management System"
                   style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-font-weight: 500;"/>
            <Label text="Sign in"
                   style="-fx-font-size: 22px; -fx-text-fill: #2c2c2a; -fx-font-weight: 500;"/>
        </VBox>

        <!-- Fields -->
        <VBox spacing="12">
            <VBox spacing="6">
                <Label text="Email"
                       style="-fx-font-size: 13px; -fx-text-fill: #5f5e5a;"/>
                <TextField fx:id="emailField"
                           promptText="you@school.edu"
                           style="-fx-font-size: 14px; -fx-background-color: white; -fx-border-color: #d3d1c7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 0.5; -fx-padding: 10 12;"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password"
                       style="-fx-font-size: 13px; -fx-text-fill: #5f5e5a;"/>
                <PasswordField fx:id="passwordField"
                               promptText="••••••••"
                               style="-fx-font-size: 14px; -fx-background-color: white; -fx-border-color: #d3d1c7; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 0.5; -fx-padding: 10 12;"/>
            </VBox>
        </VBox>

        <!-- Error label -->
        <Label fx:id="errorLabel"
               text=""
               wrapText="true"
               style="-fx-font-size: 12px; -fx-text-fill: #a32d2d;"
               maxWidth="268"/>

        <!-- Login button -->
        <Button fx:id="loginButton"
                text="Sign in"
                onAction="#handleLogin"
                maxWidth="Infinity"
                style="-fx-background-color: #2c2c2a; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 500; -fx-background-radius: 8; -fx-padding: 10 0; -fx-cursor: hand;"/>
    </VBox>
</VBox>