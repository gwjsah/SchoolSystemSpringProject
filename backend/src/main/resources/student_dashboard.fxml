<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="features.student.StudentController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #f5f4f0;">

    <!-- Sidebar -->
    <left>
        <VBox spacing="4"
              style="-fx-background-color: #2c2c2a; -fx-pref-width: 200px;">
            <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>

            <!-- Name -->
            <VBox spacing="2">
                <padding><Insets bottom="20"/></padding>
                <Label fx:id="studentNameLabel"
                       text="Student"
                       style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: white;"/>
                <Label text="Student Portal"
                       style="-fx-font-size: 11px; -fx-text-fill: #888780;"/>
            </VBox>

            <!-- Nav buttons -->
            <Button text="Announcements"
                    fx:id="sidebarAnnouncements"
                    onAction="#showAnnouncements"
                    maxWidth="Infinity"
                    style="-fx-background-color: #444441;
                    -fx-text-fill: white;
                    -fx-font-size: 13px;
                    -fx-background-radius: 6;
                    -fx-padding: 8 12;
                    -fx-alignment: CENTER-LEFT;
                    -fx-cursor: hand;"/>

            <Button text="Enrollment"
                    fx:id="sidebarEnrollment"
                    onAction="#showEnrollment"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent;
                    -fx-text-fill: #888780;
                    -fx-font-size: 13px;
                    -fx-background-radius: 6;
                    -fx-padding: 8 12;
                    -fx-alignment: CENTER-LEFT;
                    -fx-cursor: hand;"/>

            <Button text="Payments"
                    fx:id="sidebarPayments"
                    onAction="#showPayments"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent;
                    -fx-text-fill: #888780;
                    -fx-font-size: 13px;
                    -fx-background-radius: 6;
                    -fx-padding: 8 12;
                    -fx-alignment: CENTER-LEFT;
                    -fx-cursor: hand;"/>

            <Button text="Grades"
                    fx:id="sidebarGrades"
                    onAction="#showGrades"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent;
                    -fx-text-fill: #888780;
                    -fx-font-size: 13px;
                    -fx-background-radius: 6;
                    -fx-padding: 8 12;
                    -fx-alignment: CENTER-LEFT;
                    -fx-cursor: hand;"/>

            <Button text="Schedule"
                    fx:id="sidebarSchedule"
                    onAction="#showSchedule"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent;
                    -fx-text-fill: #888780;
                    -fx-font-size: 13px;
                    -fx-background-radius: 6;
                    -fx-padding: 8 12;
                    -fx-alignment: CENTER-LEFT;
                    -fx-cursor: hand;"/>

            <Button text="Evaluation"
                    fx:id="sidebarEvaluation"
                    onAction="#showEvaluation"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent;
                    -fx-text-fill: #888780;
                    -fx-font-size: 13px;
                    -fx-background-radius: 6;
                    -fx-padding: 8 12;
                    -fx-alignment: CENTER-LEFT;
                    -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Logout -->
            <Button text="Log out"
                    onAction="#handleLogout"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #888780; -fx-font-size: 13px; -fx-background-radius: 6; -fx-padding: 8 12; -fx-alignment: CENTER-LEFT; -fx-cursor: hand; -fx-border-color: #444441; -fx-border-radius: 6; -fx-border-width: 0.5;"/>
        </VBox>
    </left>

    <!-- Main content area -->
    <center>
        <VBox spacing="20">
            <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

            <!-- Page title -->
            <Label fx:id="pageTitleLabel"
                   text="Announcements"
                   style="-fx-font-size: 22px; -fx-font-weight: 500; -fx-text-fill: #2c2c2a;"/>

            <!-- Content -->
            <ScrollPane fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox fx:id="contentArea" spacing="12"/>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>