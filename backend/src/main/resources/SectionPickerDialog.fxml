<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="features.enrollment.SectionPickerController"
      spacing="0"
      prefWidth="480"
      style="-fx-background-color: #f5f4f0; -fx-background-radius: 10;">

    <!-- Header -->
    <VBox spacing="4" style="-fx-background-color: #2c2c2a; -fx-background-radius: 10 10 0 0;">
        <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
        <Label fx:id="subjectTitleLabel"
               text="Select a Section"
               style="-fx-font-size: 15px; -fx-font-weight: 500; -fx-text-fill: white;"/>
        <Label fx:id="subjectCodeLabel"
               text=""
               style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
    </VBox>

    <!-- Section list -->
    <ScrollPane fitToWidth="true" prefHeight="280"
                style="-fx-background: transparent; -fx-background-color: transparent;">
        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
        <VBox fx:id="sectionList" spacing="8"/>
    </ScrollPane>

    <!-- Footer -->
    <HBox alignment="CENTER_RIGHT" spacing="10"
          style="-fx-border-color: #dddcda transparent transparent transparent; -fx-border-width: 1 0 0 0;">
        <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
        <Button text="Cancel"
                onAction="#handleCancel"
                style="-fx-background-color: transparent; -fx-text-fill: #888780; -fx-font-size: 13px; -fx-background-radius: 6; -fx-padding: 8 16; -fx-border-color: #dddcda; -fx-border-radius: 6; -fx-border-width: 1; -fx-cursor: hand;"/>
    </HBox>
</VBox>
