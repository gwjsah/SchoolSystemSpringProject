<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="features.enrollment.EnrollmentController"
      spacing="0"
      style="-fx-background-color: transparent;">

    <!-- Header row -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <padding><Insets bottom="24"/></padding>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Enrollment"
                   style="-fx-font-size: 22px; -fx-font-weight: 500; -fx-text-fill: #2c2c2a;"/>
            <Label fx:id="enrollmentPeriodLabel"
                   text=""
                   style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
        </VBox>
        <Label fx:id="unitCountLabel"
               text="0 / 24 units"
               style="-fx-font-size: 12px; -fx-text-fill: #888780;
                      -fx-background-color: #e8e7e3; -fx-background-radius: 20; -fx-padding: 4 12;"/>
    </HBox>

    <!-- Tab bar -->
    <HBox spacing="0"
          style="-fx-border-color: transparent transparent #dddcda transparent;
                 -fx-border-width: 0 0 1 0;">
        <Button fx:id="tabSubjects" text="Available Subjects"
                onAction="#showAvailableSubjects"
                style="-fx-background-color: transparent; -fx-text-fill: #2c2c2a;
                       -fx-font-size: 13px; -fx-padding: 10 16; -fx-background-radius: 0;
                       -fx-border-color: transparent transparent #2c2c2a transparent;
                       -fx-border-width: 0 0 2 0; -fx-cursor: hand;"/>
        <Button fx:id="tabSelected" text="My Subjects"
                onAction="#showSelectedSubjects"
                style="-fx-background-color: transparent; -fx-text-fill: #888780;
                       -fx-font-size: 13px; -fx-padding: 10 16; -fx-background-radius: 0;
                       -fx-border-color: transparent; -fx-cursor: hand;"/>
    </HBox>

    <!-- Content area -->
    <VBox fx:id="contentArea" spacing="8" VBox.vgrow="ALWAYS">
        <padding><Insets top="16"/></padding>
    </VBox>

    <!-- Bottom action bar -->
    <HBox fx:id="actionBar" alignment="CENTER_RIGHT" spacing="10"
          style="-fx-border-color: #dddcda transparent transparent transparent;
                 -fx-border-width: 1 0 0 0;">
        <padding><Insets top="16"/></padding>
        <Button fx:id="dropBtn" text="Drop Subject"
                onAction="#handleDrop"
                visible="false"
                style="-fx-background-color: transparent; -fx-text-fill: #c0392b;
                       -fx-font-size: 13px; -fx-background-radius: 6; -fx-padding: 8 16;
                       -fx-border-color: #c0392b; -fx-border-radius: 6;
                       -fx-border-width: 1; -fx-cursor: hand;"/>
        <Button fx:id="confirmBtn" text="Confirm Enrollment"
                onAction="#handleConfirmEnrollment"
                style="-fx-background-color: #2c2c2a; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-background-radius: 6;
                       -fx-padding: 8 16; -fx-cursor: hand;"/>
    </HBox>

</VBox>