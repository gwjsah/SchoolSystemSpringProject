<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="features.admin.AdminController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #f5f4f0;">

    <!-- Sidebar -->
    <left>
        <VBox spacing="4"
              style="-fx-background-color: #2c2c2a; -fx-pref-width: 200px;">
            <padding><Insets top="24" right="12" bottom="24" left="12"/></padding>

            <VBox spacing="2">
                <padding><Insets bottom="20"/></padding>
                <Label fx:id="adminNameLabel"
                       text="Admin"
                       style="-fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: white;"/>
                <Label text="Admin Portal"
                       style="-fx-font-size: 11px; -fx-text-fill: #888780;"/>
            </VBox>

            <!-- Content -->
            <Label text="CONTENT"
                   style="-fx-font-size: 10px; -fx-text-fill: #555452; -fx-padding: 8 12 4 12;"/>
            <Button text="Announcements"
                    fx:id="sidebarAnnouncements"
                    onAction="#showAnnouncements"
                    maxWidth="Infinity"
                    style="-fx-background-color: #444441; -fx-text-fill: white; -fx-font-size: 13px;
                   -fx-background-radius: 6; -fx-padding: 8 12; -fx-alignment: CENTER-LEFT;
                   -fx-cursor: hand;"/>

            <!-- Academic -->
            <Label text="ACADEMIC"
                   style="-fx-font-size: 10px; -fx-text-fill: #555452; -fx-padding: 8 12 4 12;"/>
            <Button text="Rooms"
                    fx:id="sidebarRooms"
                    onAction="#showRooms"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #888780; -fx-font-size: 13px;
                   -fx-background-radius: 6; -fx-padding: 8 12; -fx-alignment: CENTER-LEFT;
                   -fx-cursor: hand;"/>
            <Button text="Schedules"
                    fx:id="sidebarSchedules"
                    onAction="#showSchedules"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #888780; -fx-font-size: 13px;
                   -fx-background-radius: 6; -fx-padding: 8 12; -fx-alignment: CENTER-LEFT;
                   -fx-cursor: hand;"/>
<!--            <Button text="Sections"-->
<!--                    fx:id="sidebarSections"-->
<!--                    onAction="#showSections"-->
<!--                    maxWidth="Infinity"-->
<!--                    style="-fx-background-color: transparent; -fx-text-fill: #888780; -fx-font-size: 13px;-->
<!--                   -fx-background-radius: 6; -fx-padding: 8 12; -fx-alignment: CENTER-LEFT;-->
<!--                   -fx-cursor: hand;"/>-->
            <Button text="Students"
                    fx:id="sidebarStudents"
                    onAction="#showStudents"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #888780; -fx-font-size: 13px;
                   -fx-background-radius: 6; -fx-padding: 8 12; -fx-alignment: CENTER-LEFT;
                   -fx-cursor: hand;"/>
            <Button text="Faculty"
                    fx:id="sidebarFaculty"
                    onAction="#showFaculty"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #888780; -fx-font-size: 13px;
                   -fx-background-radius: 6; -fx-padding: 8 12; -fx-alignment: CENTER-LEFT;
                   -fx-cursor: hand;"/>
            <Button text="Faculty Evaluation"
                    fx:id="sidebarEvaluation"
                    onAction="#showEvaluationResults"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #888780; -fx-font-size: 13px;
                   -fx-background-radius: 6; -fx-padding: 8 12; -fx-alignment: CENTER-LEFT;
                   -fx-cursor: hand;"/>

<!--             Periods-->
            <Label text="PERIODS"
                   style="-fx-font-size: 10px; -fx-text-fill: #555452; -fx-padding: 8 12 4 12;"/>
            <Button text="Enrollment Period"
                    fx:id="sidebarEnrollmentPeriod"
                    onAction="#showEnrollmentPeriod"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #888780; -fx-font-size: 13px;
                   -fx-background-radius: 6; -fx-padding: 8 12; -fx-alignment: CENTER-LEFT;
                   -fx-cursor: hand;"/>
            <Button text="Grading Period"
                    fx:id="sidebarGradingPeriod"
                    onAction="#showGradingPeriod"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #888780; -fx-font-size: 13px;
                   -fx-background-radius: 6; -fx-padding: 8 12; -fx-alignment: CENTER-LEFT;
                   -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Log out"
                    onAction="#handleLogout"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #888780; -fx-font-size: 13px;
                   -fx-background-radius: 6; -fx-padding: 8 12; -fx-alignment: CENTER-LEFT;
                   -fx-cursor: hand; -fx-border-color: #444441; -fx-border-radius: 6;
                   -fx-border-width: 0.5;"/>
        </VBox>
    </left>

    <!-- Main -->
    <center>
        <VBox spacing="20">
            <padding><Insets top="32" right="32" bottom="32" left="32"/></padding>

            <Label fx:id="pageTitleLabel"
                   text="Dashboard"
                   style="-fx-font-size: 22px; -fx-font-weight: 500; -fx-text-fill: #2c2c2a;"/>

            <ScrollPane fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox fx:id="contentArea" spacing="12"/>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
