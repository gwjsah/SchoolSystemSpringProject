<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="features.section.SectionDetailController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #f5f4f0;">

    <top>
        <VBox style="-fx-background-color: white;
                     -fx-border-color: transparent transparent #dddcda transparent;
                     -fx-border-width: 0 0 1 0;">
            <padding><Insets top="20" right="32" bottom="20" left="32"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Button fx:id="backBtn"
                        text="← My Sections"
                        onAction="#handleBack"
                        style="-fx-background-color: transparent; -fx-text-fill: #888780;
                               -fx-font-size: 13px; -fx-padding: 0; -fx-cursor: hand;"/>
                <Label fx:id="sectionTitleLabel"
                       text=""
                       style="-fx-font-size: 18px; -fx-font-weight: 500; -fx-text-fill: #2c2c2a;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="deadlineLabel"
                       text=""
                       style="-fx-font-size: 12px; -fx-text-fill: #888780;"/>
            </HBox>
            <Label fx:id="sectionDetailLabel"
                   text=""
                   style="-fx-font-size: 12px; -fx-text-fill: #888780; -fx-padding: 4 0 0 0;"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="0" fx:id="studentListContainer">
                <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

                <!-- Table header -->
                <!-- Adjust width values para ma ilisan ang gap between top labels -->
                <HBox spacing="10" style="-fx-background-color: #f5f4f0; -fx-background-radius: 6 6 0 0;">
                    <padding><Insets top="10" right="0" bottom="10" left="0"/></padding>
                    <Label text="Student"
                           style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-min-width: 125;"/>
                    <Label text="Prelim"
                           style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-min-width: 75;"/>
                    <Label text="Midterm"
                           style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-min-width: 75;"/>
                    <Label text="Pre-Final"
                           style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-min-width: 85;"/>
                    <Label text="Final"
                           style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-min-width: 70;"/>
                    <Label text="Computed Mid"
                           style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-min-width: 90;"/>
                    <Label text="Computed Final"
                           style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-min-width: 90;"/>
                    <Label text="Overall"
                           style="-fx-font-size: 11px; -fx-text-fill: #888780; -fx-min-width: 80;"/>
                    <Label text=""
                           style="-fx-min-width: 80;"/>
                </HBox>

                <VBox fx:id="studentRows" spacing="0"/>

                <Label fx:id="emptyLabel"
                       text="No enrolled students in this section."
                       visible="false" managed="false"
                       style="-fx-font-size: 13px; -fx-text-fill: #888780; -fx-padding: 16 0 0 0;"/>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>