    {
      "name": "Faculty Attendance",
      "item": [
        {
          "name": "List Generated & Recorded Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/attendance/sections/{{sectionId}}/sessions",
